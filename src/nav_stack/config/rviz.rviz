Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 42
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/RobotModel
      Name: Robot (br)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /br_robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
      # FAST-LIO 的 map 原点在 IMU 高度，地面在 map z=-0.15；栅格落到地面才不会横穿车体
      Offset:
        X: 0
        Y: 0
        Z: -0.15
    - Class: rviz_default_plugins/Map
      Name: Occupancy map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Alpha: 0.85
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.3
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
        Depth: 1
      Color Scheme: costmap
      Alpha: 0.6
      Draw Behind: false
      Use Timestamp: false
    - Class: rviz_default_plugins/Polygon
      Name: Global footprint (yellow)
      Enabled: true
      Topic:
        Value: /global_costmap/published_footprint
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 255; 210; 30
      Alpha: 1
    - Class: rviz_default_plugins/Polygon
      Name: Local footprint (cyan)
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 40; 230; 255
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Real-time scan (10Hz)
      Enabled: true
      Topic:
        Value: /cloud_registered
      Size (m): 0.035
      Style: Points
      Color Transformer: FlatColor
      Color: 0; 255; 200
    - Class: rviz_default_plugins/PointCloud2
      Name: Accumulated map cloud
      Enabled: true
      Topic:
        Value: /slam/map_cloud
      Size (m): 0.035
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
    - Class: rviz_default_plugins/Path
      Name: Optimized trajectory
      Enabled: true
      Topic:
        Value: /slam/path
      Color: 255; 80; 40
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/Path
      Name: Nav2 plan
      Enabled: true
      Topic:
        Value: /plan
      Color: 40; 255; 70
      Line Width: 0.05
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.3
      Show Names: true
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6.0
      Pitch: 0.7
      Yaw: 0.8
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.2
      Target Frame: base_link
Window Geometry:
  Width: 960
  Height: 900
  X: 0
  Y: 50
